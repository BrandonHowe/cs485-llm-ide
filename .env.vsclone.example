# VSClone local OAuth credentials (example only).
# Copy to `.env.vsclone` and set real values locally; do not commit `.env.vsclone`.
# `scripts/code.sh` loads `.env.vsclone`, `.env.local`, and `.env` automatically
# before launching the dev app so repo-local OAuth credentials stay out of source
# control without requiring a manual `source` step for every session.
VSCODE_VSCLONE_GOOGLE_CLIENT_ID=
VSCODE_VSCLONE_GOOGLE_CLIENT_SECRET=
# Optional: override the Google Cloud project billed for Gemini OAuth REST calls.
# When omitted, VSClone falls back to the project number embedded in the desktop
# OAuth client id, which is usually correct for local development.
VSCODE_VSCLONE_GOOGLE_QUOTA_PROJECT=
